{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "D2ArmorPicker": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": {
              "base": "dist/D2ArmorPicker"
            },
            "index": "src/index.html",
            "polyfills": [
              "src/polyfills.ts"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              {
                "glob": "sql-wasm.wasm",
                "input": "node_modules/sql.js/dist/",
                "output": "assets/"
              },
              {
                "glob": "highs.{wasm,mjs}",
                "input": "node_modules/highs/build/",
                "output": "assets/"
              }
            ],
            "styles": [
              {
                "input": "src/styles.scss",
                "inject": true,
                "bundleName": "styles-default"
              },
              {
                "input": "src/theme.scss",
                "inject": true,
                "bundleName": "theme-dark"
              }
            ],
            "scripts": [],
            "webWorkerTsConfig": "tsconfig.worker.json",
            "browser": "src/main.ts"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "80kb"
                }
              ],
              "fileReplacements": [],
              "outputHashing": "all",
              "sourceMap": true
            },
            "beta": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "80kb"
                }
              ],
              "fileReplacements": [],
              "outputHashing": "all",
              "sourceMap": true
            },
            "canary": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "80kb"
                }
              ],
              "fileReplacements": [],
              "styles": [
                {
                  "input": "src/styles.scss",
                  "inject": true,
                  "bundleName": "styles-default"
                },
                {
                  "input": "src/theme-canary.scss",
                  "inject": true,
                  "bundleName": "theme-dark"
                }
              ],
              "outputHashing": "all",
              "sourceMap": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "styles": [
                {
                  "input": "src/styles.scss",
                  "inject": true,
                  "bundleName": "styles-default"
                },
                {
                  "input": "src/theme-development.scss",
                  "inject": true,
                  "bundleName": "theme-dark"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "D2ArmorPicker:build:production"
            },
            "beta": {
              "buildTarget": "D2ArmorPicker:build:beta"
            },
            "canary": {
              "buildTarget": "D2ArmorPicker:build:canary"
            },
            "development": {
              "host": "192.168.100.15",
              "buildTarget": "D2ArmorPicker:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "D2ArmorPicker:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              {
                "glob": "*.wasm",
                "input": "node_modules/sql.js/dist/",
                "output": "assets/"
              },
              {
                "glob": "sql-wasm.js",
                "input": "node_modules/sql.js/dist/",
                "output": "assets/"
              },
              {
                "glob": "highs.{wasm,mjs}",
                "input": "node_modules/highs/build/",
                "output": "assets/"
              }
            ],
            "styles": [
              "./node_modules/@angular/material/prebuilt-themes/deeppurple-amber.css",
              "src/styles.scss"
            ],
            "scripts": [],
            "webWorkerTsConfig": "tsconfig.worker.json"
          }
        },
        "deploy": {
          "builder": "angular-cli-ghpages:deploy",
          "options": {}
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false,
    "schematicCollections": [
      "@angular-eslint/schematics"
    ]
  },
  "schematics": {
    "@angular-eslint/schematics:application": {
      "setParserOptionsProject": true
    },
    "@angular-eslint/schematics:library": {
      "setParserOptionsProject": true
    },
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}