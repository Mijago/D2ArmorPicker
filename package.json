{
  "name": "d2-armor-picker",
  "version": "2.10.0",
  "scripts": {
    "ng": "ng",
    "config": "ts-node set-env.ts",
    "start": "npm run config && ng serve --ssl --disable-host-check",
    "build": "npm run config && ng build",
    "deploy": "set \"RELEASE=PROD\" && npm run config && ng deploy D2ArmorPicker --base-href=/ --cname=d2armorpicker.com",
    "deploy-beta": "set \"RELEASE=BETA\" && npm run config && ng deploy D2ArmorPicker --build-target D2ArmorPicker:build:beta --repo=https://github.com/Mijago/D2ArmorPicker-beta.git --base-href=/ --cname=beta.d2armorpicker.com",
    "deploy-canary": "set \"RELEASE=CANARY\" && npm run config && ng deploy D2ArmorPicker --build-target D2ArmorPicker:build:canary --repo=https://github.com/Mijago/D2ArmorPicker-Canary.git --base-href=/ --cname=canary.d2armorpicker.com ",
    "deploy-nznaza": "set \"RELEASE=DEV\" && npm run config && ng deploy D2ArmorPicker --build-target D2ArmorPicker:build:beta --no-silent --repo=https://github.com/nznaza/D2ArmorPicker.git --base-href=/D2ArmorPicker/ --cname=nznaza.github.io/D2ArmorPicker/",
    "watch": "npm run config && ng build --watch --configuration development",
    "test": "ng test",
    "profile:theorizer": "node scripts/profile-theorizer.cjs",
    "prepare": "husky install",
    "lint": "ng lint --fix --max-warnings=0",
    "format": "prettier . --write",
    "contributors": "all-contributors generate"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@destinyitemmanager/dim-api-types": "^1.31.0",
    "@openreplay/tracker": "^17.1.6",
    "@openreplay/tracker-assist": "^11.0.11",
    "@sentry/angular": "^11.8.0",
    "all-contributors-cli": "^6.26.1",
    "angular-cli-ghpages": "^1.0.7",
    "angular-oauth2-oidc": "^12.1.0",
    "bungie-api-ts": "^5.1.0",
    "dexie": "^4.0.7",
    "highlight.run": "^9.7.1",
    "highs": "^1.15.4",
    "jszip": "^3.10.1",
    "lodash": "^4.17.21",
    "lzutf8": "^0.6.3",
    "ngx-logger": "^5.0.12",
    "rxjs": "^6.6.7",
    "sql.js": "^1.14.0",
    "tslib": "^2.6.2",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.3",
    "@angular-eslint/builder": "^22.6.0",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/schematics": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@commitlint/cli": "^18.2.12",
    "@commitlint/config-angular": "^18.2.12",
    "@eslint/js": "^10.0.1",
    "@sentry/webpack-plugin": "^4.9.1",
    "@types/jasmine": "^5.1.4",
    "@types/jszip": "^3.4.0",
    "@types/lodash": "^4.17.13",
    "@types/node": "^22.12.0",
    "@types/sql.js": "^1.4.9",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^8.10.0",
    "husky": "^8.0.0",
    "jasmine-core": "^5.4.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "lint-staged": "^15.2.10",
    "playwright": "^1.64.1",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "angular-eslint": "^22.6.0",
    "typescript-eslint": "^8.72.0"
  }
}